# Do not edit by hand: run  bash scripts/setup_env.sh  to create .env with a random password.
DB2INST1_PASSWORD=__GENERATED__
DB2_HOST=localhost
DB2_PORT=50000
DB2_DATABASE=herbdb
DB2_USER=db2inst1
DB2_PASSWORD=__GENERATED__
DB2_SECURITY=false

# auto | fastembed | hash
EMBEDDINGS=auto
# Optional: max cosine distance for a "did you mean" suggestion (empty = sensible default per embedder)
SUGGEST_MAX_DIST=

# Optional LLM (any OpenAI-compatible endpoint). Leave empty to use the deterministic explainer.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
